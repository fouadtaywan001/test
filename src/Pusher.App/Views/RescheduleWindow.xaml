<Window x:Class="Pusher.App.Views.RescheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reschedule"
        Width="720" Height="660" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
    <DockPanel>

        <!-- Title bar -->
        <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Path Data="{StaticResource AppLogo}" Fill="{StaticResource Text}"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Reschedule" Foreground="{StaticResource Text}"
                           FontSize="12" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseButton}" HorizontalAlignment="Right"
                    Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Close" />
        </Grid>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Header adapts: alarming only when something is actually missed -->
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
                        <Setter Property="Text" Value="Schedule is healthy" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMissed}" Value="True">
                                <Setter Property="Text" Value="Some pushes were missed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                        <Setter Property="Text" Value="Nothing was missed — every pending push is in the future. The timeline below shows what is coming across all projects." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMissed}" Value="True">
                                <Setter Property="Text" Value="Your PC was off (or the worker was stopped) when these pushes were planned. Commits always run in order — the earliest missed commit goes first, never a later one. Choose how to repair the schedule:" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Missed projects (hidden entirely when nothing is missed) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasMissed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Missed" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding MissedProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource Text}" FontSize="13">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding MissedCount, Mode=OneWay}" Foreground="#D29922" />
                                    <Run Text=" missed push(es), first was due " />
                                    <Run Text="{Binding FirstMissedLocal, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Repair choices (only offered when there is something to repair) -->
        <Grid Grid.Row="2" Margin="0,0,0,12"
              Visibility="{Binding HasMissed, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Catch up starting now" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="The first missed commit pushes immediately; the rest follow with random 12–35 minute gaps like a normal work session. Future pushes keep their times." />
                    <Button Content="Catch up now" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Command="{Binding CatchUpNowCommand}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Shift the schedule forward" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="Everything pending moves forward by whole days: same times of day, same day-to-day pattern, just later. Nothing pushes right now." />
                    <Button Content="Shift forward" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Command="{Binding ShiftForwardCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Timeline across all projects -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Upcoming pushes (all projects)" Foreground="{StaticResource Text}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding WhenLocal}" Style="{StaticResource Subtle}"
                                                   FontSize="12" FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProjectName}" Foreground="{StaticResource Text}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding OrderLabel}" Style="{StaticResource Subtle}"
                                                   FontSize="12" FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Subtle}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}" Click="OnCloseClick" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
    </DockPanel>
    </Border>
</Window>
