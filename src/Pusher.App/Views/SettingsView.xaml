<UserControl x:Class="Pusher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
        <TextBlock Text="GitHub account, commit identity, app behavior, and the background worker"
                   Style="{StaticResource Subtle}" Margin="0,0,0,20" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="GitHub account" Foreground="{StaticResource Text}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                <TextBlock Text="GitHub personal access token (PAT)"
                           Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Fine-grained PAT with Contents read/write on target repos. Stored DPAPI-encrypted; leave blank to keep the current one." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Commit author identity" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <Button Content="Fetch from GitHub" Style="{StaticResource GhostButton}"
                            Command="{Binding FetchIdentityCommand}" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding IdentityStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="Author name" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Author email (must be verified on your GitHub account)"
                           Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                <ComboBox IsEditable="True" Margin="0,0,0,12"
                          ItemsSource="{Binding VerifiedEmails}"
                          Text="{Binding AuthorEmail, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>
        </Border>

        <!-- ===== Application behavior ===== -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Application" Foreground="{StaticResource Text}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                <CheckBox Content="Close button hides to tray (keep running in the background)"
                          IsChecked="{Binding CloseToTray}"
                          Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <CheckBox Content="Minimize hides to tray"
                          IsChecked="{Binding MinimizeToTray}"
                          Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <CheckBox Content="Show tray notifications"
                          IsChecked="{Binding TrayNotifications}"
                          Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <CheckBox Content="Start with Windows (this user only, no admin needed)"
                          IsChecked="{Binding StartWithWindows}"
                          Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <CheckBox Content="Ask for confirmation before deleting a project"
                          IsChecked="{Binding ConfirmBeforeDelete}"
                          Foreground="{StaticResource Text}" />
            </StackPanel>
        </Border>

        <!-- ===== Scheduling ===== -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Scheduling" Foreground="{StaticResource Text}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                <CheckBox Content="Catch up missed pushes immediately at wake (otherwise reschedule)"
                          IsChecked="{Binding CatchUpImmediate}"
                          Foreground="{StaticResource Text}" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Max catch-up pushes per day" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CatchUpMaxOptions}"
                                  SelectedItem="{Binding CatchUpMaxPerDay}" />
                        <TextBlock Text="Caps burst pushes after long downtime."
                                   Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Worker poll interval (seconds)" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PollIntervalOptions}"
                                  SelectedItem="{Binding PollIntervalSeconds}" />
                        <TextBlock Text="How often the worker checks for due pushes."
                                   Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Save ===== -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save all settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Subtle}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Background worker (Windows Service)"
                               Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshWorkerCommand}" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding WorkerStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Install &amp; start" Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallWorkerCommand}"
                            Visibility="{Binding WorkerNotInstalled, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Start" Style="{StaticResource GhostButton}"
                            Command="{Binding StartWorkerCommand}"
                            Visibility="{Binding WorkerInstalled, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding StopWorkerCommand}"
                            Visibility="{Binding WorkerInstalled, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Uninstall" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding UninstallWorkerCommand}"
                            Visibility="{Binding WorkerInstalled, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Install/uninstall runs sc.exe elevated — Windows shows one UAC prompt. The service auto-starts at boot and pushes your scheduled commits in the background." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
