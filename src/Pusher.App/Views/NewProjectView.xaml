<UserControl x:Class="Pusher.App.Views.NewProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="New project" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,0,0,16">
            <Run Text="Step " /><Run Text="{Binding Step, Mode=OneWay}" /><Run Text=" of 3 — folder &amp; remote, PushScript, preview &amp; activate" />
        </TextBlock>

        <!-- footer buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Back" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
            <Button Content="Next" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" Margin="8,0,0,0" />
            <Button Content="Shuffle times" Style="{StaticResource GhostButton}" Command="{Binding ShuffleCommand}" Margin="24,0,0,0"
                    Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Activate" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateCommand}" Margin="8,0,0,0"
                    Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Subtle}"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Grid>
            <!-- STEP 1: folder + remote -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Publish mode" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ModeCard}">
                            <StackPanel>
                                <RadioButton Content="Backdated — push all now" GroupName="PublishMode"
                                             IsChecked="{Binding IsBackdatedMode}"
                                             FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="20,4,0,0"
                                           Text="For finished older projects. Every commit is created and pushed instantly when you activate — signed with the past dates from your script. No waiting, no background worker." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ModeCard}">
                            <StackPanel>
                                <RadioButton Content="Real-time — push on a schedule" GroupName="PublishMode"
                                             IsChecked="{Binding IsRealTimeMode}"
                                             FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="20,4,0,0"
                                           Text="For new projects. Commits are split and pushed automatically over the coming days by the background worker — no manual pushes needed." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Project name" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Local folder (your completed project)" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="GitHub repository" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Create a new repo on GitHub" GroupName="RepoMode"
                                     IsChecked="{Binding CreateNewRepo}" Foreground="{StaticResource Text}" />
                        <RadioButton Content="Use an existing repo URL" GroupName="RepoMode"
                                     IsChecked="{Binding UseExistingRepo}" Foreground="{StaticResource Text}" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- create-new mode -->
                    <StackPanel Visibility="{Binding CreateNewRepo, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Private repo" IsChecked="{Binding NewRepoPrivate}"
                                      Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            <Button Content="Create repo on GitHub" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CreateRepoCommand}" Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap">
                            <Run Text="Repo will be named " /><Run Text="{Binding SuggestedRepoName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" on your account (uses the PAT saved in Settings)." />
                        </TextBlock>
                        <TextBlock Text="{Binding RepoStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Text="GitHub remote URL" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="e.g. https://github.com/you/my-project.git — filled in automatically when you create a repo above"
                               Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- STEP 2: script + validation -->
            <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" MinHeight="280">
                    <TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="13"
                             Background="Transparent" BorderThickness="0" />
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                    <Button Content="Validate script + scan files"
                            Style="{StaticResource GhostButton}" Command="{Binding ValidateCommand}" />
                    <Button Content="Copy errors"
                            Style="{StaticResource GhostButton}" Command="{Binding CopyIssuesCommand}"
                            Margin="8,0,0,0"
                            ToolTip="Copies all findings (code, severity, location, message) to the clipboard" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <ListView ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource Text}" FontFamily="{StaticResource MonoFont}" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Code" Width="110" DisplayMemberBinding="{Binding Code}" />
                                <GridViewColumn Header="Severity" Width="80" DisplayMemberBinding="{Binding Severity}" />
                                <GridViewColumn Header="Where" Width="110" DisplayMemberBinding="{Binding Location}" />
                                <GridViewColumn Header="Message" Width="520" DisplayMemberBinding="{Binding Message}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- STEP 3: preview calendar -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding Preview}" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Text}" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding Order}" />
                            <GridViewColumn Header="Date" Width="110" DisplayMemberBinding="{Binding Date}" />
                            <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Message" Width="380" DisplayMemberBinding="{Binding Message}" />
                            <GridViewColumn Header="Files" Width="60" DisplayMemberBinding="{Binding FileCount}" />
                            <GridViewColumn Header="Mode" Width="100" DisplayMemberBinding="{Binding Mode}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
